      "id": "numeris-codeql-ui-app-lock-accepted-risk",
      "tool": "codeql",
      "rule": "java/android/insecure-local-authentication",
      "scope": "BiometricAppLock.kt UI app unlock and explicit import confirmation",
      "reason": "Accepted risk through 2026-10-31: this local UI privacy gate is not cryptographic protection against privileged process hooking. Report data remains readable by the app and the independent AndroidKeyStore secret key deliberately permits unattended background sync and import recovery. Existing biometric, API 28-29 device-credential fallback and background behavior are preserved. A crypto-only dummy challenge would not protect the actual data or import action. Full cryptographic data protection requires a separate decision about background access and legacy device credentials.",
      "owner": "project-maintainers",
      "added": "2026-10-12",
      "expires": "2026-10-31",
      "tracking": "local-review:numeris-codeql-ui-app-lock-accepted-risk",
